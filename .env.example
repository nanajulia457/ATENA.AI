# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" (com chaves reais) para o Git.

# --- Banco de dados (Postgres + pgvector) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_assistant
DB_USER=postgres
DB_PASSWORD=postgres
VECTOR_TABLE=document_chunks

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- LLM de geração: escolha "openai", "anthropic" ou "groq" (gratuito) ---
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Recuperação ---
TOP_K=5

# --- Caminhos ---
RAW_DOCS_DIR=data/raw

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
